{
  "dependencies": {
    "@wdio/globals": "^10.0.2"
  },
  "scripts": {
  "clean:results": "rimraf allure-results allure-report .allure",
  "pretest": "npm run clean:results",
  "pretest:login": "npm run clean:results",
  "pretest:login:single": "npm run clean:results",
  "test": "wdio run wdio.conf.ts",
  "test:login": "wdio run wdio.conf.ts --spec tests/loginTest.ts",
  "test:login:single": "wdio run wdio.conf.ts --spec tests/loginTest.ts --mochaOpts.grep",
  "report:generate": "allure generate allure-results --clean -o allure-report",
  "report:open": "allure open allure-report",
  "report": "npm run report:generate && npm run report:open"
},
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@wdio/allure-reporter": "^10.0.1",
    "@wdio/cli": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
